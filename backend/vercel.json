{
  "version": 2,
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/orders(.*)", "destination": "/api/index.js" },
    { "source": "/points/(.*)", "destination": "/api/index.js" },
    { "source": "/reservation(.*)", "destination": "/api/index.js" },
    { "source": "/db-test", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/Frontend/$1" }
  ]
}